#!/usr/bin/env bash
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
expected='17935459+LachimB@users.noreply.github.com'
for identity in GIT_AUTHOR_IDENT GIT_COMMITTER_IDENT; do
  value="$(git var "$identity")"
  [[ "$value" == "LachimB <$expected> "* ]] || { echo 'Commit rejected: confirmed GitHub noreply identity required.' >&2; exit 1; }
done
python3 tools/check_repo_hygiene.py --staged
command -v gitleaks >/dev/null || { echo 'Commit rejected: install Gitleaks before committing.' >&2; exit 1; }
gitleaks git . --pre-commit --staged --redact=100 --ignore-gitleaks-allow --no-banner

# Scan complete staged file contents with the shared secret/privacy policy.
python3 tools/security_local.py
