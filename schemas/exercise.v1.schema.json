{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gym-assistant:schema:exercise:1.0.0",
  "title": "Exercise definition",
  "type": "object",
  "required": [
    "schemaVersion",
    "familyId",
    "names",
    "variations"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "familyId": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{2,127}$"
    },
    "names": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      },
      "propertyNames": {
        "pattern": "^[a-z]{2}(-[A-Z]{2})?$"
      }
    },
    "shortNames": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      },
      "propertyNames": {
        "pattern": "^[a-z]{2}(-[A-Z]{2})?$"
      }
    },
    "description": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      },
      "propertyNames": {
        "pattern": "^[a-z]{2}(-[A-Z]{2})?$"
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "equipmentIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "variations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "variationId",
          "names"
        ],
        "properties": {
          "variationId": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{2,127}$"
          },
          "names": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": "string",
              "minLength": 1
            },
            "propertyNames": {
              "pattern": "^[a-z]{2}(-[A-Z]{2})?$"
            }
          },
          "shortNames": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": "string",
              "minLength": 1
            },
            "propertyNames": {
              "pattern": "^[a-z]{2}(-[A-Z]{2})?$"
            }
          },
          "instructions": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": "string",
              "minLength": 1
            },
            "propertyNames": {
              "pattern": "^[a-z]{2}(-[A-Z]{2})?$"
            }
          },
          "media": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "mediaId",
                "type",
                "relativePath"
              ],
              "properties": {
                "mediaId": {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{2,127}$"
                },
                "type": {
                  "enum": [
                    "image",
                    "video",
                    "animation"
                  ]
                },
                "relativePath": {
                  "type": "string",
                  "minLength": 1
                },
                "phaseId": {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{2,127}$"
                },
                "caption": {
                  "type": "object",
                  "minProperties": 1,
                  "additionalProperties": {
                    "type": "string",
                    "minLength": 1
                  },
                  "propertyNames": {
                    "pattern": "^[a-z]{2}(-[A-Z]{2})?$"
                  }
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "media": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "mediaId",
          "type",
          "relativePath"
        ],
        "properties": {
          "mediaId": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{2,127}$"
          },
          "type": {
            "enum": [
              "image",
              "video",
              "animation"
            ]
          },
          "relativePath": {
            "type": "string",
            "minLength": 1
          },
          "phaseId": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{2,127}$"
          },
          "caption": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": "string",
              "minLength": 1
            },
            "propertyNames": {
              "pattern": "^[a-z]{2}(-[A-Z]{2})?$"
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
