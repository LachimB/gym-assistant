{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gym-assistant:schema:session:1.2.0",
  "title": "Workout Session — meaningful human history (1.2.0)",
  "type": "object",
  "required": [
    "schemaVersion",
    "sessionId",
    "templateId",
    "revisionId",
    "engineVersion",
    "startedAt",
    "timeZone",
    "status",
    "events",
    "localTrainingDate",
    "completionKind",
    "sourcePlanSnapshot",
    "timing",
    "effectivePlanSnapshot",
    "adjustments"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.2.0"
    },
    "sessionId": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{2,127}$"
    },
    "templateId": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{2,127}$"
    },
    "revisionId": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{2,127}$"
    },
    "engineVersion": {
      "const": "kotlin-timed-2"
    },
    "startedAt": {
      "type": "string",
      "format": "date-time"
    },
    "finishedAt": {
      "type": "string",
      "format": "date-time"
    },
    "timeZone": {
      "type": "string",
      "minLength": 1
    },
    "localTrainingDate": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "enum": [
        "inProgress",
        "paused",
        "awaitingCompletion",
        "completed",
        "discarded"
      ]
    },
    "sourcePlanSnapshot": {
      "type": "object",
      "required": [
        "sourceSnapshotJson",
        "sourceHash",
        "compiledPlanJson",
        "compiledPlanHash",
        "planFormatVersion",
        "hashFormat"
      ],
      "properties": {
        "sourceSnapshotJson": {
          "type": "string",
          "minLength": 1
        },
        "sourceHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "compiledPlanJson": {
          "type": "string",
          "minLength": 1
        },
        "compiledPlanHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "planFormatVersion": {
          "const": "2.0.0"
        },
        "hashFormat": {
          "const": "sha256-utf8"
        }
      },
      "additionalProperties": false
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "eventId": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{2,127}$"
          },
          "type": {
            "enum": [
              "sessionStarted",
              "phaseStarted",
              "phaseCompleted",
              "pause",
              "resume",
              "skip",
              "rewind",
              "interruption",
              "planEndReached",
              "sessionEnded",
              "sessionDiscarded",
              "repetitionAdded"
            ]
          },
          "recordedAt": {
            "type": "string",
            "format": "date-time"
          },
          "scheduledElapsedMs": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "observedRunMs": {
            "type": "integer",
            "minimum": 0
          },
          "pauseMs": {
            "type": "integer",
            "minimum": 0
          },
          "unobservedGapMs": {
            "type": "integer",
            "minimum": 0
          },
          "unknownGapCount": {
            "type": "integer",
            "minimum": 0
          },
          "setId": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{2,127}$"
          },
          "detail": {
            "type": "object",
            "properties": {
              "gapDurationKnown": {
                "type": "boolean"
              },
              "gapDurationMs": {
                "type": "integer",
                "minimum": 0
              },
              "resumedAfterInterruption": {
                "const": true
              },
              "completionKind": {
                "enum": [
                  "unfinished",
                  "plannedEnd",
                  "partial",
                  "discarded"
                ]
              }
            },
            "required": [],
            "additionalProperties": false
          },
          "adjustedScheduledElapsedMs": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "phaseInstanceId": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{2,127}$"
          },
          "adjustmentId": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{2,127}$"
          }
        },
        "required": [
          "eventId",
          "type",
          "recordedAt",
          "scheduledElapsedMs",
          "observedRunMs",
          "pauseMs",
          "unobservedGapMs",
          "unknownGapCount",
          "adjustedScheduledElapsedMs"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "type": {
                  "enum": [
                    "phaseStarted",
                    "phaseCompleted",
                    "skip",
                    "rewind"
                  ]
                }
              }
            },
            "then": {
              "required": [
                "phaseInstanceId"
              ]
            },
            "else": {
              "not": {
                "required": [
                  "phaseInstanceId"
                ]
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "interruption"
                }
              }
            },
            "then": {
              "required": [
                "detail"
              ],
              "properties": {
                "detail": {
                  "required": [
                    "gapDurationKnown"
                  ],
                  "allOf": [
                    {
                      "if": {
                        "properties": {
                          "gapDurationKnown": {
                            "const": true
                          }
                        }
                      },
                      "then": {
                        "required": [
                          "gapDurationMs"
                        ]
                      },
                      "else": {
                        "not": {
                          "required": [
                            "gapDurationMs"
                          ]
                        }
                      }
                    }
                  ],
                  "type": "object"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "enum": [
                    "sessionEnded",
                    "sessionDiscarded"
                  ]
                }
              }
            },
            "then": {
              "required": [
                "detail"
              ],
              "properties": {
                "detail": {
                  "required": [
                    "completionKind"
                  ],
                  "type": "object"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "sessionEnded"
                }
              }
            },
            "then": {
              "properties": {
                "detail": {
                  "properties": {
                    "completionKind": {
                      "enum": [
                        "plannedEnd",
                        "partial"
                      ]
                    }
                  },
                  "type": "object"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "sessionDiscarded"
                }
              }
            },
            "then": {
              "properties": {
                "detail": {
                  "properties": {
                    "completionKind": {
                      "const": "discarded"
                    }
                  },
                  "type": "object"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "repetitionAdded"
                }
              }
            },
            "then": {
              "required": [
                "adjustmentId",
                "setId"
              ]
            },
            "else": {
              "not": {
                "required": [
                  "adjustmentId"
                ]
              }
            }
          }
        ]
      }
    },
    "timing": {
      "type": "object",
      "required": [
        "plannedDurationMs",
        "adjustedPlannedDurationMs",
        "adjustedScheduledElapsedMs",
        "scheduledElapsedMs",
        "observedRunMs",
        "pauseMs",
        "unobservedGapMs",
        "unknownGapCount"
      ],
      "properties": {
        "plannedDurationMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "adjustedPlannedDurationMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "adjustedScheduledElapsedMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "scheduledElapsedMs": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "observedRunMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "pauseMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "unobservedGapMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "unknownGapCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "additionalProperties": false
    },
    "completionKind": {
      "enum": [
        "unfinished",
        "plannedEnd",
        "partial",
        "discarded"
      ]
    },
    "effectivePlanSnapshot": {
      "type": "object",
      "required": [
        "compiledPlanJson",
        "compiledPlanHash",
        "planFormatVersion"
      ],
      "properties": {
        "compiledPlanJson": {
          "type": "string",
          "minLength": 1
        },
        "compiledPlanHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "planFormatVersion": {
          "const": "2.0.0"
        }
      },
      "additionalProperties": false
    },
    "adjustments": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "required": [
          "adjustmentId",
          "setId",
          "recordedAt"
        ],
        "properties": {
          "adjustmentId": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{2,127}$"
          },
          "setId": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{2,127}$"
          },
          "recordedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "completionKind": {
            "enum": [
              "plannedEnd",
              "partial",
              "discarded"
            ]
          }
        }
      },
      "then": {
        "required": [
          "finishedAt"
        ],
        "properties": {
          "status": {
            "enum": [
              "completed",
              "discarded"
            ]
          }
        }
      },
      "else": {
        "not": {
          "required": [
            "finishedAt"
          ]
        },
        "properties": {
          "status": {
            "enum": [
              "inProgress",
              "paused",
              "awaitingCompletion"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "completionKind": {
            "const": "discarded"
          }
        }
      },
      "then": {
        "properties": {
          "status": {
            "const": "discarded"
          }
        }
      },
      "else": {
        "properties": {
          "status": {
            "not": {
              "const": "discarded"
            }
          }
        }
      }
    }
  ]
}
