{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gym-assistant:schema:season-participation:1.0.0",
  "title": "Season Participation (draft initial contract)",
  "type": "object",
  "required": [
    "schemaVersion",
    "participationId",
    "revisionId",
    "seasonId",
    "programId",
    "status"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "participationId": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{2,127}$"
    },
    "seasonId": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{2,127}$"
    },
    "programId": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{2,127}$"
    },
    "revisionId": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{2,127}$"
    },
    "status": {
      "enum": [
        "planned",
        "active",
        "paused",
        "ended"
      ]
    },
    "startedAt": {
      "type": "string",
      "format": "date-time"
    },
    "endedAt": {
      "type": "string",
      "format": "date-time"
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "eventId",
          "at",
          "from",
          "to"
        ],
        "properties": {
          "eventId": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{2,127}$"
          },
          "at": {
            "type": "string",
            "format": "date-time"
          },
          "from": {
            "enum": [
              "planned",
              "active",
              "paused",
              "ended"
            ]
          },
          "to": {
            "enum": [
              "planned",
              "active",
              "paused",
              "ended"
            ]
          },
          "reason": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
