{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.test/schemas/template-sync-revision.v1.schema.json",
  "title": "template-sync-revision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "templateId",
    "revisionId",
    "previousRevisionId",
    "sourceHash",
    "compiledPlanHash",
    "engineVersion",
    "files"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "templateId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{2,127}$"
    },
    "revisionId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{2,127}$"
    },
    "previousRevisionId": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{2,127}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "sourceHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "compiledPlanHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "engineVersion": {
      "const": "kotlin-timed-2"
    },
    "files": {
      "type": "array",
      "minItems": 2,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "role",
          "relativeName",
          "objectId",
          "sha256",
          "byteCount"
        ],
        "properties": {
          "role": {
            "enum": [
              "template",
              "exercise"
            ]
          },
          "relativeName": {
            "type": "string",
            "maxLength": 128,
            "allOf": [
              {
                "pattern": "^[^./\\\\:\\u0000-\\u001f][^/\\\\:\\u0000-\\u001f]*\\.ya?ml$"
              },
              {
                "not": {
                  "pattern": "\\.\\."
                }
              }
            ]
          },
          "objectId": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,160}$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "byteCount": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1048576
          }
        }
      },
      "contains": {
        "type": "object",
        "required": [
          "role"
        ],
        "properties": {
          "role": {
            "const": "template"
          }
        }
      },
      "minContains": 1,
      "maxContains": 1
    }
  }
}
