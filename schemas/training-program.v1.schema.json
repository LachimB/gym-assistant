{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:gym-assistant:schema:training-program:1.0.0",
  "title": "Training Program (draft initial contract)",
  "type": "object",
  "required": [
    "schemaVersion",
    "programId",
    "revisionId",
    "names",
    "status",
    "templateMemberships"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "programId": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{2,127}$"
    },
    "revisionId": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{2,127}$"
    },
    "status": {
      "enum": [
        "draft",
        "planned",
        "active",
        "paused",
        "completed",
        "abandoned"
      ]
    },
    "names": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z]{2}(-[A-Z]{2})?$"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "description": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "notes": {
      "type": "string"
    },
    "focus": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "goals": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "tags": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "visual": {
      "type": "object",
      "properties": {
        "color": {
          "type": "string"
        },
        "icon": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "startDate": {
      "type": "string",
      "format": "date"
    },
    "endDate": {
      "type": "string",
      "format": "date"
    },
    "suggestedWeeklyFrequency": {
      "type": "integer",
      "minimum": 0
    },
    "suggestedRotation": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{2,127}$"
      }
    },
    "archivedAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "clonedFromId": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{2,127}$"
    },
    "templateMemberships": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "membershipId",
          "templateId",
          "versionPolicy"
        ],
        "properties": {
          "membershipId": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{2,127}$"
          },
          "templateId": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{2,127}$"
          },
          "versionPolicy": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "mode": {
                    "const": "latest"
                  }
                },
                "required": [
                  "mode"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "mode": {
                    "const": "pinned"
                  },
                  "revisionId": {
                    "type": "string",
                    "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{2,127}$"
                  }
                },
                "required": [
                  "mode",
                  "revisionId"
                ],
                "additionalProperties": false
              }
            ]
          },
          "overrides": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "blockId",
                "occurrenceId",
                "setId",
                "values"
              ],
              "properties": {
                "blockId": {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{2,127}$"
                },
                "occurrenceId": {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{2,127}$"
                },
                "setId": {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{2,127}$"
                },
                "values": {
                  "type": "object",
                  "minProperties": 1,
                  "properties": {
                    "repetitions": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "leftRepetitions": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "rightRepetitions": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "resistance": {
                      "type": "object"
                    },
                    "phaseDurations": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "object",
                        "required": [
                          "phaseId",
                          "durationMs"
                        ],
                        "properties": {
                          "phaseId": {
                            "type": "string",
                            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{2,127}$"
                          },
                          "durationMs": {
                            "type": "integer",
                            "minimum": 0
                          }
                        },
                        "additionalProperties": false
                      }
                    },
                    "restDurationMs": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "tempo": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "additionalProperties": false
                }
              },
              "additionalProperties": false
            }
          },
          "setUsage": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "blockId",
                "setId",
                "copies"
              ],
              "properties": {
                "blockId": {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{2,127}$"
                },
                "setId": {
                  "type": "string",
                  "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{2,127}$"
                },
                "copies": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 16
                }
              },
              "additionalProperties": false
            }
          },
          "lastValidated": {
            "type": "object",
            "required": [
              "templateRevisionId",
              "effectivePlanHash"
            ],
            "properties": {
              "templateRevisionId": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{2,127}$"
              },
              "effectivePlanHash": {
                "type": "string",
                "minLength": 1
              },
              "verifiedAt": {
                "type": "string",
                "format": "date-time"
              }
            },
            "additionalProperties": false
          },
          "pendingUpgrade": {
            "type": "object",
            "required": [
              "candidateRevisionId",
              "reason"
            ],
            "properties": {
              "candidateRevisionId": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{2,127}$"
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}
