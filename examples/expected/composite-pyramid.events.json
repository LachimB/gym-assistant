        {"type": "unobservedGap", "scheduledElapsedMs": 4000, "observedRunMs": 5000, "pauseMs": 0, "unobservedGapMs": 8000, "phaseIndex": null},
        {"type": "resumeAfterGap", "scheduledElapsedMs": 4000, "observedRunMs": 5000, "pauseMs": 0, "unobservedGapMs": 8000, "phaseIndex": null},
