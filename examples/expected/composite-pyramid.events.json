        {"type": "phaseCompleted", "scheduledElapsedMs": 32000, "observedRunMs": 32000, "pauseMs": 0, "unobservedGapMs": 0, "phaseIndex": 5},
        {"type": "phaseStarted", "scheduledElapsedMs": 32000, "observedRunMs": 32000, "pauseMs": 0, "unobservedGapMs": 0, "phaseIndex": 6},
