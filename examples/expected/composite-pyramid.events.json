        {"type": "phaseStarted", "scheduledElapsedMs": 0, "observedRunMs": 0, "pauseMs": 0, "unobservedGapMs": 0, "phaseIndex": 0},
        {"type": "unobservedGap", "scheduledElapsedMs": 1000, "observedRunMs": 1000, "pauseMs": 0, "unobservedGapMs": 8000, "phaseIndex": null}
      ],
      "expectedState": {
        "status": "recoveredPaused",
        "scheduledElapsedMs": 1000,
        "observedRunMs": 1000,
        "pauseMs": 0,
        "unobservedGapMs": 8000,
        "completedPhaseIndexes": []
      }
    },
